{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dallas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prevenda-dallas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cart-vip-boston",
      "destination": "/boston?ingresso=vip#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-boston",
      "destination": "/boston?ingresso=standard#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-miami",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cart-vip-miami",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cart-orlando",
      "destination": "/orlando?ingresso=standard#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-vip-orlando",
      "destination": "/orlando?ingresso=vip#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-dl",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cart-vip",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/en/dallas",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/en/prevenda-dallas",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/es/dallas",
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/es/prevenda-dallas",
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/cart-orlando-rei",
      "destination": "/orlando?ingresso=rei#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-boston-rei",
      "destination": "/boston?ingresso=rei#ingressos",
      "permanent": false
    },
    {
      "source": "/cart-:resto*",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reenviar",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/cron/*.mjs": {
      "maxDuration": 60
    },
    "api/admin/*.mjs": {
      "maxDuration": 60
    },
    "api/checkout/*.mjs": {
      "maxDuration": 30
    },
    "api/pedido.mjs": {
      "maxDuration": 30
    },
    "api/painel/*.mjs": {
      "maxDuration": 60
    }
  }
}
